# GTM Autopilot — environment
# Copy to .env and fill in. Placeholders only — never commit real values.
# HubSpot, Salesforce and Apollo are NOT configured here: connect them in the app
# (Connections page). Their credentials are stored encrypted per workspace.

# ─── Supabase (Project Settings → API / Database) ────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_KEY=<service-role-key>             # server-side only, never in the browser
SUPABASE_JWT_SECRET=<jwt-secret>                    # Project Settings → API → JWT secret (legacy HS256 projects)

# Used by migrations AND by the worker for durable LangGraph checkpoints (schema "langgraph").
# Required: the worker exits at startup without it. Use the session pooler URL if the direct host is IPv6-only.
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Encryption for stored connector credentials ─────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing it means reconnecting every tool; leaking it exposes stored credentials.
APP_ENCRYPTION_KEY=<32-byte-base64-key>

# ─── Runtime ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379                    # docker compose overrides this
PUBLIC_API_URL=http://localhost:3000                # public URL of the API: HubSpot sends webhooks here
DASHBOARD_URL=http://localhost:3001                 # where users open the app (sign-in links point here)
API_URL=http://localhost:3000                       # dashboard → API (server-side); compose sets http://api:3000

# ─── Optional ────────────────────────────────────────────────────────────────
# ACTIVE_ORG_IDS=<uuid>,<uuid>                      # limit the SLA/outcome jobs to these workspaces (default: all active)

# ─── Upgrading an install from before the Connections page ───────────────────
# Only for scripts/import-env-credentials.mjs (one-time copy into a workspace). Remove afterwards.
# HUBSPOT_API_KEY=<hubspot-private-app-token>
# HUBSPOT_WEBHOOK_SECRET=<hubspot-app-client-secret>
# SF_CLIENT_ID=<salesforce-consumer-key>
# SF_CLIENT_SECRET=<salesforce-consumer-secret>
# SF_INSTANCE_URL=https://<your-domain>.my.salesforce.com
# SF_SANDBOX=false
# APOLLO_API_KEY=<apollo-api-key>

# ─── AI models (v2, optional) — see docs/ai-models.md ───────────────────────
# Your own Ollama on this machine. Which model to use is chosen in the web app, not here.
OLLAMA_BASE_URL=http://ollama.internal:11434      # with `docker compose --profile ollama up -d` (Linux); Docker Desktop: http://host.docker.internal:11434
# Model call limits in the worker (defaults shown). Invalid values stop the call with an error.
# MODEL_TIMEOUT_MS=30000
# MODEL_MAX_CONCURRENCY=2
# MODEL_MAX_QUEUE=100
